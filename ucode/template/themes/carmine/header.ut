{#
 Carmine - a clean, modern theme for LuCI
 Licensed to the public under the Apache License 2.0.
-#}

{%
	import { getuid, getspnam } from 'luci.core';

	const boardinfo = ubus.call('system', 'board') ?? {};
	const hostname = striptags(boardinfo.hostname ?? 'OpenWrt');
	const darkpref = (theme == 'carmine-dark') ? 'dark' : ((theme == 'carmine-light') ? 'light' : null);
	const pagepath = length(ctx.request_path) ? ctx.request_path : ctx.path;

	http.prepare_content('text/html; charset=UTF-8');
-%}

<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}" data-mode="{{ darkpref ?? 'auto' }}" data-darkmode="{{ darkpref == 'dark' ? 'true' : 'false' }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="darkreader-lock">
<meta name="color-scheme" content="{{ darkpref ?? 'light dark' }}">
<title>{{ striptags(`${hostname}${dispatched?.title ? ` | ${_(dispatched.title)}` : ''}`) }}</title>
<script>
(function() {
	var root = document.documentElement,
	    forced = root.getAttribute('data-mode'),
	    mq = window.matchMedia ? window.matchMedia('(prefers-color-scheme: dark)') : null,
	    saved = null;

	try { saved = window.localStorage.getItem('carmine.mode'); } catch (e) {}

	function apply() {
		var dark = (forced == 'dark') || (forced != 'light' && (saved == 'dark' || (saved != 'light' && mq && mq.matches)));
		root.setAttribute('data-darkmode', dark ? 'true' : 'false');
	}

	window.carmineSetMode = function(mode) {
		saved = mode;
		try {
			if (mode) window.localStorage.setItem('carmine.mode', mode);
			else window.localStorage.removeItem('carmine.mode');
		} catch (e) {}
		apply();
	};

	if (mq && forced == 'auto') {
		if (mq.addEventListener) mq.addEventListener('change', apply);
		else if (mq.addListener) mq.addListener(apply);
	}

	apply();
})();
</script>
<link rel="stylesheet" href="{{ media }}/cascade.css?v=1.0.0-{{ pkgs_update_time ?? 0 }}">
<link rel="icon" href="{{ media }}/logo_48.png" sizes="48x48">
<link rel="icon" href="{{ media }}/logo.svg" sizes="any">
<link rel="apple-touch-icon" href="{{ media }}/logo_180.png">
{% if (dispatched?.css): %}
<link rel="stylesheet" href="{{ resource }}/{{ dispatched.css }}">
{% endif %}
{% if (css): %}
<style title="text/css">{{ css }}</style>
{% endif %}
<script src="{{ dispatcher.build_url('admin/translations', dispatcher.lang) }}"></script>
<script src="{{ resource }}/cbi.js"></script>
</head>

<body class="lang_{{ dispatcher.lang }}{{ blank_page ? ' blank-page' : '' }}{{ ctx.authsession ? ' logged-in' : '' }}" data-page="{{ entityencode(join('-', pagepath), true) }}">
{% if (!blank_page): %}
<aside id="sidebar">
	<a class="brand" href="{{ dispatcher.build_url() }}">
		<img class="brand-logo" src="{{ media }}/logo.svg" alt="" width="36" height="36">
		<span class="brand-text">
			<strong>{{ hostname }}</strong>
			<small>{{ version.distname }} {{ version.distversion }}</small>
		</span>
	</a>
	<ul id="modemenu" style="display:none"></ul>
	<nav id="mainmenu" aria-label="{{ _('Navigation') }}" style="display:none"></nav>
</aside>
<div id="scrim"></div>

<div id="page">
	<header id="topbar">
		<button type="button" id="menu-toggle" class="icon-btn" aria-label="{{ _('Navigation') }}" aria-controls="sidebar" aria-expanded="false"><span class="i i-menu"></span></button>
		<div id="crumbs"></div>
		<div id="indicators"></div>
		{% if (!darkpref): %}
		<button type="button" id="mode-toggle" class="icon-btn" aria-label="Light / dark" title="Light / dark"><span class="i i-mode"></span></button>
		{% endif %}
		<span id="logout-slot"></span>
	</header>

	<main id="maincontent">
		{% if (getuid() == 0 && getspnam('root')?.pwdp === '' && join('-', pagepath) != 'admin-system-admin'): %}
		<div class="alert-message warning">
			<h4>{{ _('No password set!') }}</h4>
			<p>{{ _('There is no password set on this router. Please configure a root password to protect the web interface.') }}</p>
			{% if (dispatcher.lookup("admin/system/admin")): %}
			<div class="right"><a class="btn" href="{{ dispatcher.build_url("admin/system/admin") }}">{{ _('Go to password configuration...') }}</a></div>
			{% endif %}
		</div>
		{% endif %}

		{% if (boardinfo.rootfs_type == "initramfs"): %}
		<div class="alert-message warning">
			<h4>{{ _('System running in recovery (initramfs) mode.') }}</h4>
			<p>{{ _('No changes to settings will be stored and are lost after rebooting. This mode should only be used to install a firmware upgrade') }}</p>
			{% if (dispatcher.lookup("admin/system/flash")): %}
			<div class="right"><a class="btn" href="{{ dispatcher.build_url("admin/system/flash") }}">{{ _('Go to firmware upgrade...') }}</a></div>
			{% endif %}
		</div>
		{% endif %}

		<noscript>
			<div class="alert-message warning">
				<h4>{{ _('JavaScript required!') }}</h4>
				<p>{{ _('You must enable JavaScript in your browser or LuCI will not work properly.') }}</p>
			</div>
		</noscript>

		<div id="tabmenu" style="display:none"></div>
{% endif %}
